      "description": "软件ID",
      "required": true,
      "type": "string"
     },
     {
      "name": "firmware_version",
      "in": "query",
      "description": "软件版本（预留字段，不参与任何逻辑）",
      "required": false,
      "type": "string"
     },
     {
      "name": "access_token",
      "in": "query",
      "description": "access_token",
      "required": false,
      "type": "string"
     },
     {
      "name": "app_id",
      "in": "query",
      "description": "app_id",
      "required": false,
      "type": "string"
     },
     {
      "name": "app_secret",
      "in": "query",
      "description": "app_secret",
      "required": false,
